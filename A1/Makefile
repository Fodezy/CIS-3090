CC := gcc
CFLAGS := -O2 -Wall -Wextra -Werror -pedantic -std=c11
LDFLAGS := -pthread

SRC_DIR := src
BIN_PARALLEL := A1
BIN_SERIAL := baseLinePi

SRC_PARALLEL := $(SRC_DIR)/A1.c
SRC_SERIAL := $(SRC_DIR)/baseLinePi.c

# Used to make all targets (both parallel and serial pie progams)
all: $(BIN_PARALLEL) $(BIN_SERIAL)

# Used to make only the parallel target (links the pthreads library)
$(BIN_PARALLEL): $(SRC_PARALLEL)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^

# Used to make only the serial target (exludes the pthreads library)
$(BIN_SERIAL): $(SRC_SERIAL)
	$(CC) $(CFLAGS) -o $@ $^

# Cleans all binaries (if any) and all object files generated by make
clean:
	rm -f $(BIN_PARALLEL) $(BIN_SERIAL) *.o *.out
# 	del /Q $(BIN).exe 